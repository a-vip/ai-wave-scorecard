# Postgres connection (Neon / Vercel "Neon" integration sets DATABASE_URL automatically).
# Leave empty for local dev: responses are then saved to data/responses-local.json.
DATABASE_URL=

# Owner key for the hidden "Responses" tab. Open the site with ?owner to reveal it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
