# Postgres connection (use a free Neon database: https://neon.tech). REQUIRED in production.
# Leave empty for local dev: responses are then saved to data/responses-local.json.
DATABASE_URL=

# Owner key for the hidden "Responses" tab. Open the site with ?owner to reveal it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Public origin of the site (no trailing slash). Used for canonical, social-share image and sitemap URLs.
# Needs to be present at BUILD time. Example: https://aiwave.aviperera.com
NEXT_PUBLIC_SITE_URL=

# CI / local production testing ONLY: allow the JSON-file store when NODE_ENV=production.
# Never set this on the real host (its file system is wiped on each deploy).
# ALLOW_LOCAL_STORE=1
